# v3 needs no task settings here: API keys, databases, URLs and prompts are all set in the web app (Settings / Agent).
# Everything below is infrastructure.

# REQUIRED. PostgreSQL connection string for the app's own data (secrets, tasks, runs, logs, learned steps).
# From a Supabase project: Connect -> "Session pooler" -> copy the URI, and put your database password in it.
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Encrypts stored secrets. Leave unset to have one generated at storage/master.key on first use.
# Generate your own with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up: without it every saved secret is unreadable.
# SECRETS_ENCRYPTION_KEY=

# For a server with no screen: run every browser headless whatever a task says
# FORCE_HEADLESS=1

# LOCAL TESTING ONLY: open the Add-secret form in Settings pre-filled with GEMINI_API_KEY / SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY from this file, so you only click Save. Answers requests from this machine only.
# Delete the line (or set it to 0) to turn it off.
# DEV_PREFILL_SECRETS=1

ANONYMIZED_TELEMETRY=false

# Gemini keys (the README says where they are used; the web app can also store them). Extra keys (_2, _3, ...): the agent switches
# between all keys when one is busy or out of daily quota. Use keys from different Google projects: the quota is per project.
# The tool-comparison proxy in ../bench also reads them from here.
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=

# Optional overrides (defaults shown)
# MODEL_NAME=gemini-3.5-flash-lite          # main model
# FALLBACK_MODEL=gemini-3.1-flash-lite      # used when the main model's daily quota is out (slower)
# GEMINI_RPM=14                             # calls per minute per key and model; 0 turns pacing off
# MAX_CONCURRENT_REPLAYS=10
# HEADLESS=1                                # default for tasks that do not say
# TA_FEATURES=                              # experimental parts, off by default; "all" turns them on (see docs/problems.md)

# Local-only Supabase values, used by DEV_PREFILL_SECRETS above and by the old v1/v2 apps
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
