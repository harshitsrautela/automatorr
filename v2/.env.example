# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase (target database the browser agent's form writes into)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_TABLE=people

# Target form the browser agent fills in (localhost during dev)
TARGET_FORM_URL=http://localhost:3000/form

# Optional overrides
MODEL_NAME=gemini-3.5-flash-lite
THINKING_LEVEL=low
MATCH_KEY_FIELD=email
RESULTS_STORE_PATH=storage/results.json


# --- Caching layer (this v2 only - see CACHING_LAYER.md) ---
CACHE_DB_PATH=storage/cache.sqlite3
WORKFLOW_NAME=datadesk_people_form
CDP_DEBUG_PORT=9333
REPLAY_ELEMENT_TIMEOUT_MS=5000
ANONYMIZED_TELEMETRY=false
