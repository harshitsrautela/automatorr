# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase (target database the browser agent's form writes into)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_TABLE=people

# Target form the browser agent fills in (localhost during dev)
TARGET_FORM_URL=http://localhost:3000/form

# Optional overrides
MODEL_NAME=gemini-3.5-flash-lite
THINKING_LEVEL=low
MATCH_KEY_FIELD=email
RESULTS_STORE_PATH=storage/results.json

# false (default) = v1, records run sequentially, one at a time.
# true = v2, every record runs at once, each in its own isolated Chrome
# window. Only flip this on when there's real headroom on the Gemini
# quota -- concurrent agents share one rate limit. See LEARNINGS.md.
CONCURRENT_MODE=false
